
      ! ****************************************************************
      ! user inputs
      logical,parameter :: wrt_file_rst      = .false.     ! t/f to write module history file
      real,parameter    :: output_period_rst = 2000        ! output period in seconds
      logical,parameter :: monthly_restarts = .false.      ! This overrides output_period
      integer,parameter :: nrpf_rst          =  2          ! total recs per file
      
      logical,parameter :: wrt_file_his      = .false.    ! t/f to write module history file
      real,parameter    :: output_period_his = 120      ! output period in seconds
      integer,parameter :: nrpf_his          = 30        ! total recs per file      
      logical,parameter :: wrt_Z =.true.,
     &                     wrt_Ub=.true.,
     &                     wrt_Vb=.true.,
     &                     wrt_U=.true.,
     &                     wrt_V=.true.,
     &                     wrt_R=.true.,
     &                     wrt_O=.false.,
     &                     wrt_W=.true.,
     &                     wrt_Akv=.true.,
     &                     wrt_Akt=.true.,
     &                     wrt_Aks=.false.,
     &                     wrt_Hbls=.true.,
     &                     wrt_Hbbl=.true.
      
      logical,parameter :: wrt_file_avg      = .true.     ! t/f to write module averages file
      real,parameter    :: output_period_avg = 86400         ! output averaging period in seconds
      integer,parameter :: nrpf_avg          = 30          ! total recs per file
      logical,parameter :: wrt_avg_Z =.true.,
     &                     wrt_avg_Ub=.true.,
     &                     wrt_avg_Vb=.true.,
     &                     wrt_avg_U=.true.,
     &                     wrt_avg_V=.true.,
     &                     wrt_avg_R=.true.,
     &                     wrt_avg_O=.true.,
     &                     wrt_avg_W=.true.,
     &                     wrt_avg_Akv=.true.,
     &                     wrt_avg_Akt=.true.,
     &                     wrt_avg_Aks=.true.,
     &                     wrt_avg_Hbls=.true.,
     &                     wrt_avg_Hbbl=.true.

      logical :: code_check = .false.            ! keep as false unless for code_check      
      ! end user inputs
      ! ****************************************************************
