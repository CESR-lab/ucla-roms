      !KELP ADDS ADDITIONAL REACTIVE TRACERS TO BEC 
#ifdef MAGBEC_COUPLE 
      !LARGE KELP POC
      itot=itot+1;                 iKELPPOClrg=itot
      wrt_t  (itot)=.True.;        wrt_t_avg(itot)=.True.
      t_vname(itot)='kelpPOClrg';  t_units  (itot)='mMol C m-3'
      t_tname(itot)='';            t_ana_frc(itot)=1
      t_lname(itot)='large particulate organic kelp carbon'
      wrt_t_dia(itot)=.false.
      t_wsink(itot)=-0.012 ! 1000 m / day (Sten paper)
      t_bry_dat(itot)=.false.
      !t_anamin(itot) = 0
      !t_anamax(itot) = 0
      !t_anagamma(itot) = 1 



   

      !SMALL KELP POC
      itot=itot+1;                 iKELPPOCsm=itot
      wrt_t  (itot)=.True.;        wrt_t_avg(itot)=.True.
      t_vname(itot)='kelpPOCsm';   t_units  (itot)='mMol C m-3'
      t_tname(itot)='';            t_ana_frc(itot)=1
      t_lname(itot)='small particulate organic kelp carbon'
      wrt_t_dia(itot)=.false.
      t_wsink(itot)=-0.0006 ! 50 m / day (Sten)
      t_bry_dat(itot)=.false.
      !t_anamin(itot) = 0
      !t_anamax(itot) = 0
      !t_anagamma(itot) = 1 



   

      !PROCSSED (HARVESTED) KELP POC
      itot=itot+1;                 iKELPPOChrv=itot
      wrt_t  (itot)=.True.;        wrt_t_avg(itot)=.True.
      t_vname(itot)='kelpPOChrv';   t_units  (itot)='mMol C m-3'
