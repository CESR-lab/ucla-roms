      t_lname(itot)='processed particulate organic kelp carbon'
      wrt_t_dia(itot)=.false.
      t_wsink(itot)=--0.012 !same as large (1000 m / day) 
      t_bry_dat(itot)=.false.
      !t_anamin(itot) = 0
      !t_anamax(itot) = 0
      !t_anagamma(itot) = 1 



      !LABILE KELP DOC
      itot=itot+1;                 iKELPDOC=itot
      wrt_t  (itot)=.True.;        wrt_t_avg(itot)=.True.
      t_vname(itot)='kelpDOC';  t_units  (itot)='mMol C m-3'
      t_tname(itot)='';            t_ana_frc(itot)=1
      t_lname(itot)='kelp dissolved organic carbon (labile)'
      wrt_t_dia(itot)=.false.
      t_wsink(itot)=0.0
      t_bry_dat(itot)=.false.
      !t_anamin(itot) = 0
      !t_anamax(itot) = 0
      !t_anagamma(itot) = 1 



      !REFRACTORY KELP DOC
      itot=itot+1;                 iKELPDOCR=itot
      wrt_t  (itot)=.True.;        wrt_t_avg(itot)=.True.
      t_vname(itot)='kelpDOCR';    t_units  (itot)='mMol C m-3'
      t_tname(itot)='';            t_ana_frc(itot)=1
      t_lname(itot)='kelp dissolved organic carbon (refractory)'
      wrt_t_dia(itot)=.false.
      t_wsink(itot)=0.0
      t_bry_dat(itot)=.false.
      !t_anamin(itot) = 0
      !t_anamax(itot) = 0
      !t_anagamma(itot) = 1 


#endif

#endif /* BIOLOGY_BEC2 */
